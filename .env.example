# --- Backend ---
# Async driver required (asyncpg). For local dev without Docker you can use
# sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# --- Azure AI Foundry (Azure OpenAI) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Playwright MCP (used by the researcher agent in the "revise my draft"
# flow). Optional — defaults shown below, only set if you need to override.
# PLAYWRIGHT_MCP_COMMAND=npx
# PLAYWRIGHT_MCP_ARGS=["-y", "@playwright/mcp@latest", "--headless", "--isolated"]

# --- Frontend ---
VITE_API_URL=http://localhost:8000
